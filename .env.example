# ─────────────────────────────────────────────────────────────────────────────
# Frontend  (VITE_* is compiled into the browser bundle — never put secrets here)
# ─────────────────────────────────────────────────────────────────────────────

# true  → in-browser fixture backend, no server or database needed
# false → talk to the API server below
VITE_USE_MOCK=true

# Left as /api so the Vite dev server proxies to the API on the same origin.
VITE_API_URL=/api

VITE_APP_NAME=Admin Panel


# ─────────────────────────────────────────────────────────────────────────────
# Database  (server-side only — never exposed to the browser)
# Set DATABASE_URL, run `pnpm dev:full`, and every table becomes a REST resource.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/admin

# MySQL / MariaDB
# DATABASE_URL=mysql://root:secret@localhost:3306/admin

# SQLite (file path, or :memory:)
# DATABASE_URL=sqlite:./data/admin.db

# SQL Server
# DATABASE_URL=mssql://sa:Str0ng!Pass@localhost:1433/admin

# MongoDB
# DATABASE_URL=mongodb://localhost:27017/admin

API_PORT=4000
API_ORIGIN=http://localhost:5173

# Restrict which tables are exposed. Empty = every table found.
# DB_TABLES=users,roles,posts
# DB_HIDDEN_TABLES=migrations,sessions,password_resets
# DB_SCHEMA=public

# Row-level ownership, as `table:column` pairs. A caller then reaches only rows
# whose column matches their user id, unless they hold `<resource>.<action>.any`
# (or `*`). Empty = no ownership scoping, which is the default behaviour.
# OWNED_TABLES=posts:author_id,comments:user_id

# Text search configuration for tables that have a `tsvector` column. Must match
# whatever the generated column was built with, or the two disagree on stemming.
# SEARCH_TEXT_CONFIG=english

# Migrations (`pnpm db:migrate`). The bookkeeping tables are never exposed as resources.
# DB_MIGRATIONS_TABLE=knex_migrations
# DB_AUTO_MIGRATE=false      # true → the API applies pending migrations on boot
# DB_ALLOW_ROLLBACK=false    # true → `db:migrate rollback` works under NODE_ENV=production


# ─────────────────────────────────────────────────────────────────────────────
# Auth — points at columns your database already has
# ─────────────────────────────────────────────────────────────────────────────

AUTH_TABLE=users
AUTH_EMAIL_COLUMN=email
AUTH_PASSWORD_COLUMN=password
AUTH_NAME_COLUMN=name

# Optional role model. If the role table is absent, every signed-in user gets `*`.
AUTH_ROLE_TABLE=roles
AUTH_ROLE_FK=role_id
AUTH_ROLE_NAME_COLUMN=slug
AUTH_PERMISSIONS_COLUMN=permissions

# Fallback account used when the database has no users table at all.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# Required in production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Resolving the caller costs a `users` read plus a `roles` read on every
# request; this reuses the result for a few seconds. The cost is staleness — a
# disabled account or an edited role stays live this long. 0 re-reads always.
# AUTH_CACHE_TTL=5


# ─────────────────────────────────────────────────────────────────────────────
# Serving — concurrency, throttling, logging
# ─────────────────────────────────────────────────────────────────────────────

# Every in-flight query holds one connection, so this is the ceiling on how many
# slow queries it takes to stall the panel. Raise it with the database's own
# max_connections in mind.
# DB_POOL_MIN=0
# DB_POOL_MAX=10

# Trust `X-Forwarded-For` for the client address. Enable ONLY behind a proxy
# that overwrites it — otherwise any caller can spoof past the rate limits.
# TRUST_PROXY=false

# Rate limits. Defaults to on under NODE_ENV=production. The limiter is
# per-instance, so behind N replicas the effective budget is N x the limit.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10           # sign-in attempts...
# RATE_LIMIT_LOGIN_WINDOW=300   # ...per this many seconds, per IP and per account
# RATE_LIMIT_API=600            # authenticated requests...
# RATE_LIMIT_API_WINDOW=60      # ...per this many seconds, per IP

# In production, successful requests slower than this are logged.
# SLOW_REQUEST_MS=1000

# An unfiltered list over this many rows reports the planner's row estimate
# instead of running count(*). 0 always counts exactly.
# LIST_ESTIMATE_COUNT_ABOVE=50000

# A filtered or searched list stops counting at this many matches and reports
# "at least N". Counting every match of a broad search term is a full scan.
# LIST_COUNT_CAP=50000

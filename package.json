{
  "name": "filament-style-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@8.7.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"docs/**/*.md\" \"scripts/*.mjs\" README.md AGENTS.md",
    "gen:resource": "node scripts/gen-resource.mjs",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "concurrently -n web,api -c cyan,magenta \"pnpm dev\" \"pnpm dev:api\"",
    "start:api": "tsx server/index.ts",
    "db:introspect": "tsx server/cli/introspect.ts",
    "db:seed": "tsx server/cli/seed.ts",
    "db:seed:bulk": "tsx server/cli/seed-bulk.ts",
    "db:bench": "tsx server/cli/bench.ts",
    "db:migrate": "tsx server/cli/migrate.ts",
    "db:migrate:make": "tsx server/cli/migrate.ts make",
    "db:migrate:status": "tsx server/cli/migrate.ts status",
    "db:rollback": "tsx server/cli/migrate.ts rollback"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "axios": "^1.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.5.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router": "^7.2.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.3",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "concurrently": "^9.1.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/pg": "^8.11.11"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1",
    "mongodb": "^6.13.1",
    "tedious": "^18.6.1"
  }
}
